# Example App Launcher Configuration
# Place this file at ~/.config/nosh/app_launcher.toml

# Example custom application entry
[[entry]]
name = "My Custom Script"
icon = "application-x-executable"
exec = "/home/user/scripts/my-script.sh"

# Example terminal in specific directory
[[entry]]
name = "Terminal (Home)"
icon = "utilities-terminal"
exec = "alacritty --working-directory ~"

# Example GUI application
[[entry]]
name = "VS Code (Projects)"
icon = "vscode"
exec = "code ~/projects"

# Example web browser with specific profile
[[entry]]
name = "Firefox (Work Profile)"
icon = "firefox"
exec = "firefox -P work"

# Example system command
[[entry]]
name = "System Monitor"
icon = "utilities-system-monitor"
exec = "gnome-system-monitor"
