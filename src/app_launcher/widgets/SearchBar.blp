using Gtk 4.0;

template $AppLauncherWidgetsSearchBar: Box {
    orientation: horizontal;
    spacing: 8;

    SearchEntry search_entry {
        placeholder-text: "Search applications...";
        hexpand: true;

        styles [
            "SearchBar",
        ]
    }

    Image plugin_icon {
        visible: false;
        pixel-size: 24;
        valign: baseline_center;

        styles [
            "plugin-icon",
        ]
    }
}
